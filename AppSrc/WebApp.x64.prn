37772>>>>>>>>>>>        tWebNavigateData NavigateData
37772>>>>>>>>>>>        tWebNavigateData NavigateData
37772>>>>>>>>>>>        Boolean bHasRecord
37772>>>>>>>>>>>        Handle hoDD
37772>>>>>>>>>>>
37772>>>>>>>>>>>        Get Server to hoDD
37773>>>>>>>>>>>        Get GetNavigateData to NavigateData
37774>>>>>>>>>>>        Get HasRecord of hoDD to bHasRecord
37775>>>>>>>>>>>
37775>>>>>>>>>>>        // let's hide all buttons and then Show the ones we want
37775>>>>>>>>>>>        WebSet pbRender of oEditBtn to False
37776>>>>>>>>>>>        WebSet pbRender of oSaveBtn to False
37777>>>>>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37778>>>>>>>>>>>        WebSet pbRender of oDeleteBtn to False
37779>>>>>>>>>>>
37779>>>>>>>>>>>        If (NavigateData.bReadOnly) Begin
37781>>>>>>>>>>>            WebSet pbRender of oEditBtn to True
37782>>>>>>>>>>>        End
37782>>>>>>>>>>>>
37782>>>>>>>>>>>        Else Begin
37783>>>>>>>>>>>            WebSet pbRender of oSaveBtn to True
37784>>>>>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37785>>>>>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37786>>>>>>>>>>>        End
37786>>>>>>>>>>>>
37786>>>>>>>>>>>    End_Procedure
