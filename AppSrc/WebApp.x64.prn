37837>>>>>>>>>>>        Case Begin
37837>>>>>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37839>>>>>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37839>>>>>>>>>>>                Case Break
37840>>>>>>>>>>>
37840>>>>>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37843>>>>>>>>>>>                // If from parent, this is a constrained drill down.
37843>>>>>>>>>>>                Case Break
37844>>>>>>>>>>>
