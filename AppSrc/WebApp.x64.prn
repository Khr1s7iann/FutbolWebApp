37465>>>>>>>>>>>>>>>    Procedure SetActionButtons
37468>>>>>>>>>>>>>>>        tWebNavigateData NavigateData
37468>>>>>>>>>>>>>>>        tWebNavigateData NavigateData
37468>>>>>>>>>>>>>>>        Boolean bHasRecord
37468>>>>>>>>>>>>>>>        Handle hoDD
37468>>>>>>>>>>>>>>>
37468>>>>>>>>>>>>>>>        Get Server to hoDD
37469>>>>>>>>>>>>>>>        Get GetNavigateData to NavigateData
37470>>>>>>>>>>>>>>>        Get HasRecord of hoDD to bHasRecord
37471>>>>>>>>>>>>>>>
37471>>>>>>>>>>>>>>>        // let's hide all buttons and then Show the ones we want
37471>>>>>>>>>>>>>>>        WebSet pbRender of oEditBtn to False
37472>>>>>>>>>>>>>>>        WebSet pbRender of oSaveBtn to False
37473>>>>>>>>>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37474>>>>>>>>>>>>>>>        WebSet pbRender of oDeleteBtn to False
37475>>>>>>>>>>>>>>>
37475>>>>>>>>>>>>>>>        If (NavigateData.bReadOnly) Begin
37477>>>>>>>>>>>>>>>            WebSet pbRender of oEditBtn to True
37478>>>>>>>>>>>>>>>        End
37478>>>>>>>>>>>>>>>>
37478>>>>>>>>>>>>>>>        Else Begin
37479>>>>>>>>>>>>>>>            WebSet pbRender of oSaveBtn to True
37480>>>>>>>>>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37481>>>>>>>>>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37482>>>>>>>>>>>>>>>        End
37482>>>>>>>>>>>>>>>>
37482>>>>>>>>>>>>>>>    End_Procedure
