
// C:\DataFlex Projects\futbol\AppSrc\SelectEntrenador.wo
// Lista de entrenadores
//

Use cWebView.pkg
Use cWebList.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebColumnButton.pkg
Use cWebColumn.pkg
Use ZoomEntrenador.wo

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use centrenadorDataDictionary.dd

Object oSelectEntrenador is a cWebView
    Set psCaption to "Lista de entrenadores"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtSelect
    Set piColumnCount to 12
    Set pbShowCaption to False
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server to oliga_DD
    End_Object 

    Object oentrenador_DD is a centrenadorDataDictionary
        Set DDO_Server to oequipo_DD
    End_Object 

    Set Main_DD to oentrenador_DD
    Set Server  to oentrenador_DD

    Object oList is a cWebList
        Set piColumnSpan to 0
        Set psCSSClass to "MobileList"
        Set pbServerOnRowClick to True
        Set pbFillHeight to True
        Set pbShowHeader to False
        Set piSortColumn to 0

        Object oentrenadorNombre is a cWebColumn
            Entry_Item entrenador.Nombre
            Set psCaption to "entrenador.Nombre"
            Set piWidth to 745
        End_Object 

        // FROM MAIN: SelectEntrenador -> ZoomEntrenador
        // Mismo DD (centrenador) en invocante e invocada.
        // La barra libre carga el entrenador seleccionado sola.
        Object oDetailButton is a cWebColumnButton
            Set psCaption to "btn"
            Set piWidth to 45
            Set pbFixedWidth to True
            Set pbResizable to False
            Set piListRowSpan to 3
            Set psBtnCssClass to "WebButtonIcon WebIcon_Info"
            Set peAlign to alignRight

            WebRegisterPath ntNavigateForward oZoomEntrenador

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            // EVENTO 1 - OnGetNavigateForwardData
            // En el InvokingObject, ANTES de navegar.
            // FROM MAIN: mismo DD, navegamos en solo lectura.
            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bReadOnly
                Send ShowInfoBox "FROM MAIN|InvokingObject: oDetailButton|Se produce ANTES de navegar|bReadOnly = True" "Evento 1: OnGetNavigateForwardData"
            End_Procedure

            // EVENTO 4 - OnNavigateBack
            // En el InvokingObject, cuando VUELVES de la vista invocada.
            // Cierra el ciclo de la navegacion.
            Procedure OnNavigateBack tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
                Send ShowInfoBox "FROM MAIN|InvokingObject: oDetailButton|Se produce al VOLVER del ZoomEntrenador|Ciclo cerrado" "Evento 4: OnNavigateBack"
            End_Procedure

        End_Object 

        Object oentrenadorApellido is a cWebColumn
            Entry_Item entrenador.Apellido
            Set psCaption to "entrenador.Apellido"
            Set piWidth to 745
            Set pbNewLine to True
        End_Object 

        Object oentrenadorNacionalidad is a cWebColumn
            Entry_Item entrenador.Nacionalidad
            Set psCaption to "entrenador.Nacionalidad"
            Set piWidth to 621
            Set pbNewLine to True
        End_Object 

        Procedure OnRowClick String sRowId
            tWebNavigateData NavigateData
            Get GetNavigateData to NavigateData

            Case Begin
                Case (NavigateData.eNavigateType = nfFromParent)
                    Send ShowInfoBox "FROM PARENT|Vengo de una vista padre|Cierro y devuelvo seleccion" "Tipo de navegacion"
                    Send NavigateClose Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromChild)
                    Send ShowInfoBox "FROM CHILD|Vengo de una vista hijo|Cierro y devuelvo seleccion" "Tipo de navegacion"
                    Send NavigateClose Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromMain)
                    Send ShowInfoBox "FROM MAIN|Mismo DD|Cierro navegacion" "Tipo de navegacion"
                    Send NavigateClose Self
                    Case Break

                Case Else
                    Send ShowInfoBox "UNDEFINED|Sin relacion entre DD|Sin barra libre" "Tipo de navegacion"

            Case End
        End_Procedure

        Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
            Move True to NavigateData.bReadOnly
        End_Procedure

    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSearch is a cWebMenuItem
            Set psCSSClass to "WebPromptMenuItem"
            Set psCaption to "Search"

            Procedure OnClick
                Send Search of oList
            End_Procedure

        End_Object 

        Object oNewButton is a cWebMenuItem
            Set psCSSClass to "WebClearMenuItem"
            Set psCaption to "New"

            WebRegisterPath ntNavigateForward oZoomEntrenador

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            // FROM MAIN: mismo DD, nuevo registro
            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bNewRecord
                Send ShowInfoBox "FROM MAIN|InvokingObject: oNewButton|bNewRecord = True|Navego a crear nuevo entrenador" "Evento 1: OnGetNavigateForwardData"
            End_Procedure

        End_Object 
    End_Object 

    // EVENTO 2 - OnNavigateForward (puerta de entrada a SelectEntrenador)
    // Se produce cuando LLEGO a esta vista desde otra.
    // Customizo lo que se muestra segun de donde vengo.
    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        WebSet pbRender of oNewButton to True
        WebSet pbRender of oDetailButton to True

        Case Begin
            Case (NavigateData.eNavigateType = nfFromParent)
                Send ShowInfoBox "FROM PARENT|Llego desde una vista padre|Solo muestro los hijos de ese padre|New Button ocultado" "Evento 2: OnNavigateForward"
                WebSet pbRender of oNewButton to False
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                Send ShowInfoBox "FROM CHILD|Llego desde un hijo que quiere elegir|New y Detail ocultados" "Evento 2: OnNavigateForward"
                WebSet pbRender of oNewButton to False
                WebSet pbRender of oDetailButton to False
                Case Break

            Case (NavigateData.eNavigateType = nfFromMain)
                Send ShowInfoBox "FROM MAIN|Mismo DD en ambas vistas|Detail ocultado" "Evento 2: OnNavigateForward"
                WebSet pbRender of oDetailButton to False
                Case Break

            Case Else
                Send ShowInfoBox "UNDEFINED|Sin relacion entre DD|Sin barra libre" "Evento 2: OnNavigateForward"

        Case End

    End_Procedure

End_Object